          "steps": [
            "Heat mustard oil in a non-stick pan over medium heat until it starts to splutter.",
            "Add mustard seeds and cumin seeds, and temper them until they turn golden brown.",
            "Add asafoetida (hing) and fresh curry leaves, and saut\u00e9 for 10 seconds until fragrant.",
            "Add the leftover boiled rice, turmeric powder, red chili powder, and salt to the pan.",
            "Add 1/2 cup of water, mix well, and let it simmer for 2-3 minutes until the water evaporates and the rice becomes fluffy.",
            "Turn off the heat and let the rice cool slightly before serving.",
            "Squeeze the juice of one lemon into a glass.",
            "Add 1/4 cup of sugar and 1/2 cup of water to the lemon juice and stir until the sugar dissolves.",
            "Add 1 cup of ice cubes to the glass and stir well.",
            "Serve the warm mustard-curry leaf rice alongside the chilled lemon cooler."
          ],
          "steps_hi": [
            "\u092e\u0927\u094d\u092f\u092e \u0906\u0902\u091a \u092a\u0930 \u090f\u0915 \u0917\u0948\u0930-\u091a\u093f\u092a\u091a\u093f\u092a\u093e\u0924\u0947 \u092a\u0948\u0928 \u092e\u0947\u0902 \u0938\u0930\u0938\u094b\u0902 \u0915\u093e \u0924\u0947\u0932 \u0917\u0930\u094d\u092e \u0915\u0930\u0947\u0902 \u091c\u092c \u0924\u0915 \u0915\u093f \u092f\u0939 \u092b\u0942\u091f\u0928\u0947 \u0932\u0917\u0947\u0964",
