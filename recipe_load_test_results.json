          "pairing_notes_hi": "\u092c\u091a\u093e \u0939\u0941\u0906 \u092c\u0942\u0902\u0926\u0940 \u091a\u093e\u0935\u0932 \u0915\u094b \u0938\u0930\u0938\u094b\u0902 \u0915\u0947 \u0926\u093e\u0928\u094b\u0902 \u0914\u0930 \u0915\u0930\u0940 \u092a\u0924\u094d\u0924\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0926\u0915\u094d\u0937\u093f\u0923 \u092d\u093e\u0930\u0924\u0940\u092f '\u092a\u094b\u0902\u0917\u0932' \u0938\u094d\u091f\u093e\u0907\u0932 \u0915\u0947 \u0938\u0942\u0916\u0947 \u091a\u093e\u0935\u0932 \u092e\u0947\u0902 \u092c\u0926\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u0917\u0930\u094d\u092e, \u0938\u094d\u0935\u093e\u0926\u093f\u0937\u094d\u091f \u0914\u0930 \u0938\u0941\u0917\u0902\u0927\u093f\u0924 \u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0928\u0940\u0902\u092c\u0942 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u090f\u0915 \u0924\u093e\u091c\u093c\u093e, \u0920\u0902\u0921\u093e \u0928\u0940\u0902\u092c\u0942 \u0915\u0942\u0932\u0930 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u094b \u0938\u0930\u0938\u094b\u0902 \u0915\u0947 \u0924\u0947\u0932 \u0915\u0940 \u092d\u093e\u0930\u0940\u092a\u0928 \u0915\u094b \u0915\u093e\u091f\u0924\u093e \u0939\u0948 \u0914\u0930 \u090f\u0915 \u091a\u092e\u0915\u0940\u0932\u093e, \u0938\u093f\u091f\u094d\u0930\u0938-\u0906\u0927\u093e\u0930\u093f\u0924 \u0935\u093f\u0930\u094b\u0927\u093e\u092d\u093e\u0938 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u091c\u094b\u0921\u093c\u0940 \u091a\u093e\u0935\u0932 \u0915\u0947 \u092d\u093e\u0930\u0940, \u092e\u093f\u091f\u094d\u091f\u0940 \u091c\u0948\u0938\u0947 \u0938\u094d\u0935\u093e\u0926\u094b\u0902 \u0915\u094b \u092a\u0947\u092f \u0915\u0947 \u0939\u0932\u094d\u0915\u0947, \u0905\u092e\u094d\u0932\u0940\u092f \u0924\u093e\u091c\u093c\u09